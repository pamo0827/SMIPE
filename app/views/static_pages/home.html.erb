<div class="hero hero-compact">
  <div class="hero-content">
    <img src="<%= asset_path('favicon.ico') %>" alt="SMIPE Logo" class="hero-logo">
    <h1 class="app-title">SMIPE</h1>
    <p class="app-tagline">YouTubeの音楽をシンプルに楽しむ</p>
    <div class="login-box">
      <%= link_to '音楽を聴く', player_page_path, class: 'btn-primary', style: 'display: inline-block; padding: 15px 40px; background-color: #1DB954; color: white; text-decoration: none; border-radius: 30px; font-size: 1.1em; font-weight: bold; margin-bottom: 15px;' %>

      <% if !logged_in? %>
        <div style="margin-top: 20px;">
          <%= link_to 'ログイン', login_path, style: 'display: inline-block; background-color: transparent; border: 2px solid #1DB954; color: #1DB954; padding: 12px 30px; border-radius: 25px; cursor: pointer; font-size: 1em; text-decoration: none;' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<section class="features">
  <h2 class="section-title">SMIPEでできること</h2>
  <div class="feature-grid">
    <div class="feature-item">
      <i class="fas fa-music feature-icon"></i>
      <h3>トレンド音楽</h3>
      <p>日本のトレンド音楽を自動再生。新しい曲との出会いを。</p>
    </div>
    <div class="feature-item">
      <i class="fas fa-search feature-icon"></i>
      <h3>音楽検索</h3>
      <p>好きな曲やアーティストを検索して再生。</p>
    </div>
    <div class="feature-item">
      <i class="fas fa-heart feature-icon"></i>
      <h3>お気に入り</h3>
      <p>GOODボタンでお気に入りの曲を記録。</p>
    </div>
  </div>
</section>

<footer>
  <p>&copy; 2024 SMIPE. All Rights Reserved.</p>
  <p style="margin-top: 10px;">
    <%= link_to '利用規約', terms_path, style: 'color: #1DB954; text-decoration: none;' %> |
    <%= link_to 'プライバシーポリシー', privacy_path, style: 'color: #1DB954; text-decoration: none;' %>
  </p>
</footer>
