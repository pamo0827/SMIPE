<%= csrf_meta_tags %>
<div data-controller="map"
     class="map-container"
     data-map-user-location-value="<%= @user_location.to_json %>"
     data-map-logged-in-value="<%= logged_in? %>">

  <div class="map-wrapper">
    <div id="map" style="height:600px;"></div>
  </div>

  <div class="location-info">
    <h3>位置情報</h3>
    <div data-map-target="locationDisplay" id="location-display">
      <% if @user_location && @user_location[:latitude].present? && @user_location[:longitude].present? %>
        <div class="address">
          <strong>現在地:</strong><br>
          <%= @user_location[:address] %>
        </div>
      <% else %>
        <div class="loading">
          <div class="spinner"></div>
          <p>位置情報を取得中...</p>
        </div>
      <% end %>
    </div>

    <button data-map-target="updateButton"
            data-action="click->map#updateLocation"
            class="update-button">位置を更新</button>

    <!-- YouTube音楽検索セクション -->
    <div class="youtube-search-section" style="margin-top: 30px;">
      <h3>YouTube音楽を検索</h3>
      <div class="search-form">
        <input type="text"
               data-map-target="searchInput"
               placeholder="曲名 または 曲名 アーティスト名"
               class="search-input"
               style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 10px;">
        <button data-action="click->map#searchMusic"
                class="search-button"
                style="width: 100%; padding: 10px; background-color: #1DB954; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
          <i class="fab fa-youtube" style="margin-right: 5px;"></i>検索
        </button>
      </div>

      <!-- 検索結果表示エリア -->
      <div data-map-target="searchResults" class="search-results" style="margin-top: 20px; max-height: 400px; overflow-y: auto; display: none;">
        <h4 style="margin-bottom: 10px;">検索結果</h4>
        <div data-map-target="resultsContainer" class="results-container"></div>
      </div>

      <!-- 選択された曲の情報 -->
      <div data-map-target="selectedVideo" class="selected-video" style="margin-top: 20px; display: none;">
        <h4 style="margin-bottom: 10px;">選択中の曲</h4>
        <div data-map-target="selectedVideoInfo" class="selected-video-info" style="padding: 15px; background-color: #f5f5f5; border-radius: 5px;"></div>

        <% if logged_in? %>
          <button data-action="click->map#postToMap"
                  data-map-target="postButton"
                  class="post-button"
                  style="width: 100%; margin-top: 15px; padding: 12px; background-color: #1DB954; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 1.1em;">
            <i class="fas fa-map-marker-alt" style="margin-right: 5px;"></i>この曲を地図に投稿
          </button>
        <% else %>
          <div class="login-prompt" style="margin-top: 15px; padding: 15px; background-color: rgba(255,255,255,0.1); border-radius: 8px; text-align: center;">
            <p style="margin-bottom: 10px; color: #B3B3B3;">地図に音楽を投稿するにはログインが必要です</p>
            <%= button_to 'Googleでログイン', '/auth/google_oauth2', method: :post, class: 'btn-secondary', params: { authenticity_token: form_authenticity_token }, data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>

    <div data-map-target="statusMessage" id="statusMessage"></div>
  </div>
</div>
