<div class="player-container">
  <!-- Header -->
  <header class="player-header">
    <div class="header-left">
      <!-- 戻るボタンやメニューが必要ならここに -->
    </div>
    <div class="header-title">Now Playing</div>
    <div class="header-right">
      <% if logged_in? %>
        <%= link_to settings_path, class: "control-btn secondary" do %>
          <i class="fas fa-cog"></i>
        <% end %>
      <% else %>
        <%= link_to login_path, class: "control-btn secondary" do %>
          <i class="fas fa-sign-in-alt"></i>
        <% end %>
      <% end %>
    </div>
  </header>

  <main class="player-content"
    data-controller="youtube-player"
    data-youtube-player-video-ids="<%= @video_ids.to_json %>"
    data-youtube-player-current-index-value="0"
    data-youtube-player-playing-value="false">

    <!-- Hidden YouTube Player -->
    <div id="youtube-player" data-youtube-player-target="videoPlayer" style="display: none;"></div>

    <!-- Album Art & Swipe Area -->
    <div class="album-art-wrapper">
      <div class="album-art-card" 
           id="album-art-section" 
           data-youtube-player-target="albumArt"
           data-action="click->youtube-player#togglePlay">
        
        <% if @first_video && @first_video[:thumbnail] %>
          <%= image_tag @first_video[:thumbnail], alt: "Album Art", class: "album-image", data: { youtube_player_target: "albumImage" } %>
        <% else %>
          <%= image_tag "image.png", alt: "Album Art", class: "album-image", data: { youtube_player_target: "albumImage" } %>
        <% end %>

        <!-- Swipe Indicators (Overlays) -->
        <div class="swipe-overlay right">
          <i class="fas fa-heart swipe-icon"></i>
        </div>
        <div class="swipe-overlay left">
          <i class="fas fa-heart-broken swipe-icon"></i>
        </div>
        <div class="swipe-overlay up">
          <i class="fas fa-exchange-alt swipe-icon"></i>
        </div>
        <div class="swipe-overlay down">
          <i class="fas fa-step-backward swipe-icon"></i>
        </div>
      </div>
    </div>

    <!-- Track Info -->
    <div class="track-info">
      <div class="track-title" data-youtube-player-target="songTitle"><%= @first_video&.[](:title) || 'Loading...' %></div>
      <p class="artist-name" data-youtube-player-target="artistName"><%= @first_video&.[](:channel_name) || '...' %></p>
    </div>

    <!-- Progress Bar -->
    <div class="progress-container" data-youtube-player-target="progressBarContainer">
      <span class="progress-time" data-youtube-player-target="currentTime">0:00</span>
      <div class="progress-bar-wrapper">
        <div class="progress-bar-fill" style="width: 0%" data-youtube-player-target="progressBarFill"></div>
        <div class="progress-bar-thumb"></div>
        <input type="range" 
               class="progress-bar-input" 
               min="0" max="100" value="0" step="0.1"
               data-youtube-player-target="progressBar"
               data-action="input->youtube-player#handleSeek"
               style="position: absolute; top:0; left:0; width:100%; height:100%; opacity:0; cursor:pointer;">
      </div>
      <span class="progress-time" data-youtube-player-target="duration">0:00</span>
    </div>

    <!-- Controls -->
    <div class="player-controls">
      <!-- Like/Dislike (Left Side) -->
      <% if logged_in? %>
        <button class="control-btn secondary" data-action="click->youtube-player#dislikeVideo">
          <i class="fas fa-heart-broken"></i>
        </button>
      <% else %>
        <button class="control-btn secondary" disabled style="opacity: 0.3"><i class="fas fa-heart-broken"></i></button>
      <% end %>

      <!-- Prev -->
      <button class="control-btn" data-action="click->youtube-player#handlePrevious">
        <svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
      </button>

      <!-- Play/Pause -->
      <button class="control-btn play-pause" data-action="click->youtube-player#togglePlay" data-youtube-player-target="playPauseButton">
        <svg data-youtube-player-target="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <svg data-youtube-player-target="pauseIcon" viewBox="0 0 24 24" style="display: none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <!-- Next -->
      <button class="control-btn" data-action="click->youtube-player#handleNext">
        <svg viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2z"/></svg>
      </button>

      <!-- Like (Right Side) -->
      <% if logged_in? %>
        <button class="control-btn secondary" data-action="click->youtube-player#likeVideo">
          <i class="fas fa-heart"></i>
        </button>
      <% else %>
        <button class="control-btn secondary" disabled style="opacity: 0.3"><i class="fas fa-heart"></i></button>
      <% end %>
    </div>

    <!-- Exchange / Connect -->
    <div class="exchange-area">
      <% if logged_in? %>
        <button class="btn-exchange" data-action="click->youtube-player#postToQueue">
          <i class="fas fa-broadcast-tower"></i> この曲をこの場所でシェア
        </button>
      <% else %>
        <%= link_to login_path, class: "btn-exchange" do %>
          <i class="fas fa-sign-in-alt"></i> ログインしてシェア
        <% end %>
      <% end %>
    </div>

  </main>
</div>

<!-- Tutorial Overlay (Can be hidden by JS) -->
<div id="swipe-tutorial" class="swipe-tutorial" style="display: none;">
  <!-- Tutorial content same as before, style updated in CSS if needed -->
</div>

<% if @queue_message.present? %>
  <div id="toast-message" data-message="<%= @queue_message %>"></div>
  <script>
    document.addEventListener('turbo:load', () => {
      const msg = document.getElementById('toast-message').dataset.message;
      if(msg && window.toastr) toastr.success(msg);
    });
  </script>
<% end %>