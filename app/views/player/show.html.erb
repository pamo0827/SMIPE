<div class="player-container">
  <main class="player-content"
    data-controller="youtube-player"
    data-youtube-player-video-ids="<%= @video_ids.to_json %>"
    data-youtube-player-current-index-value="0"
    data-youtube-player-playing-value="false">

    <!-- YouTube Player (hidden) -->
    <div id="youtube-player" data-youtube-player-target="videoPlayer" style="display: none;"></div>

    <div class="album-art-section" id="album-art-section" data-youtube-player-target="albumArt">
      <% if @first_video && @first_video[:thumbnail] %>
        <%= image_tag @first_video[:thumbnail], alt: "Video Thumbnail", class: "album-image", data: { youtube_player_target: "albumImage", action: "click->youtube-player#togglePlay" } %>
      <% else %>
        <%= image_tag "image.png", alt: "Video Thumbnail", class: "album-image", data: { youtube_player_target: "albumImage", action: "click->youtube-player#togglePlay" } %>
      <% end %>

      <!-- スワイプインジケーター -->
      <div class="swipe-indicator right">
        <i class="fas fa-heart"></i>
      </div>

      <div class="swipe-indicator left">
        <i class="fas fa-heart-broken"></i>
      </div>

      <div class="swipe-indicator up">
        <i class="fas fa-chevron-up"></i>
      </div>

      <div class="swipe-indicator down">
        <i class="fas fa-chevron-down"></i>
      </div>

      <!-- スワイプ中の視覚的フィードバック -->
      <div class="swiping"></div>
    </div>

    <!-- トラック詳細を画像の下に移動 -->
    <div class="track-details">
      <p class="song-title" data-youtube-player-target="songTitle"><%= @first_video&.[](:title) || 'No Video' %></p>
      <p class="artist-name" data-youtube-player-target="artistName"><%= @first_video&.[](:channel_name) || 'Unknown Channel' %></p>
    </div>

    <!-- 再生バー（シークバー） -->
    <div class="player-progress-bar" data-youtube-player-target="progressBarContainer" style="width: 300px; margin-top: -20px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
      <span class="progress-time" data-youtube-player-target="currentTime" style="font-size: 0.9em; color: #B3B3B3; min-width: 40px;">0:00</span>
      <input type="range"
             data-youtube-player-target="progressBar"
             data-action="input->youtube-player#handleSeek"
             class="progress-bar"
             min="0"
             max="100"
             value="0"
             step="1"
             style="flex: 1; accent-color: #1DB954; height: 4px; border-radius: 2px;">
      <span class="progress-time" data-youtube-player-target="duration" style="font-size: 0.9em; color: #B3B3B3; min-width: 40px;">0:00</span>
    </div>

    <div class="player-actions">
      <% if logged_in? %>
        <!-- いいねボタン（ログイン時のみ表示） -->
        <button class="action-button like-button" data-youtube-player-target="likeButton" data-action="click->youtube-player#likeVideo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>Like</span>
        </button>
      <% end %>

      <button class="action-button prev-button" data-action="click->youtube-player#handlePrevious">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 18V6h2v12H6zm3.5-6l8.5 6V6l-8.5 6z"/>
        </svg>
        <span>Prev</span>
      </button>

      <button class="action-button play-button center"
              data-action="click->youtube-player#togglePlay"
              data-youtube-player-target="playPauseButton">
        <svg data-youtube-player-target="playIcon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg data-youtube-player-target="pauseIcon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span>PLAY</span>
      </button>

      <button class="action-button skip-button" data-action="click->youtube-player#handleNext">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
        </svg>
        <span>Skip</span>
      </button>

      <% if logged_in? %>
        <!-- 嫌いボタン（ログイン時のみ表示） -->
        <button class="action-button dislike-button" data-youtube-player-target="dislikeButton" data-action="click->youtube-player#dislikeVideo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.65l1.45 1.32C18.6 8.64 22 11.72 22 15.5 22 18.58 19.58 21 16.5 21c-1.74 0-3.41-.81-4.5-2.09C10.91 20.19 9.24 21 7.5 21 4.42 21 2 18.58 2 15.5c0-3.78 3.4-6.86 8.55-11.54L12 2.65z"/>
          </svg>
          <span>Dislike</span>
        </button>
      <% end %>
    </div>

    <% unless logged_in? %>
      <div class="login-prompt" style="text-align: center; margin-top: 20px; padding: 15px; background-color: rgba(255,255,255,0.1); border-radius: 8px;">
        <p style="margin-bottom: 10px; color: #B3B3B3;">地図に音楽を投稿するにはログインが必要です</p>
        <%= button_to 'Googleでログイン', '/auth/google_oauth2', method: :post, class: 'btn-secondary', params: { authenticity_token: form_authenticity_token }, data: { turbo: false } %>
      </div>
    <% end %>
  </main>

  <footer class="player-footer">
    <p class="youtube-credit">Music provided by YouTube</p>
    <p class="footer-links">
      <%= link_to '利用規約', terms_path %> |
      <%= link_to 'プライバシーポリシー', privacy_path %>
    </p>
  </footer>
</div>
