<aside class="sidebar" id="sidebar">
  <% unless current_page?(login_path) %>
    <!-- プレイリストセクション -->
    <div class="sidebar-library">
      <div class="sidebar-library-header">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M3 22a1 1 0 0 1-1-1V3a1 1 0 0 1 2 0v18a1 1 0 0 1-1 1zM15.5 2.134A1 1 0 0 0 14 3v18a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V6.464a1 1 0 0 0-.5-.866l-6-3.464zM9 2a1 1 0 0 0-1 1v18a1 1 0 1 0 2 0V3a1 1 0 0 0-1-1z"/>
        </svg>
        <span>Your Library</span>
      </div>

      <div class="sidebar-playlists" id="sidebarPlaylists">
        <% if logged_in? %>
          <div class="playlist-items" data-controller="sidebar-playlists">
            <div class="loading-playlists">読み込み中...</div>
          </div>
        <% else %>
          <div class="sidebar-login-prompt">
            <p>プレイリストを作成</p>
            <p class="sidebar-login-subtitle">ログインしてプレイリストを保存しましょう</p>
            <%= button_to 'ログイン', '/auth/google_oauth2', method: :post, class: 'sidebar-login-btn', params: { authenticity_token: form_authenticity_token }, data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</aside>
